<?xml version="1.0"?>
<robot name="crazyflie">
  <!-- Crazyflie 2.1 inspired quadcopter model
       Total mass ~27g, motor-to-motor diagonal ~92mm -->

  <link name="base_link">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.015"/>
      <inertia ixx="1.5e-5" ixy="0" ixz="0" iyy="1.5e-5" iyz="0" izz="2.5e-5"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.03 0.03 0.015"/>
      </geometry>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.03 0.03 0.015"/>
      </geometry>
    </collision>
  </link>

  <!-- Arm 0: +X direction -->
  <link name="arm_0">
    <inertial>
      <origin xyz="0.02 0 0" rpy="0 0 0"/>
      <mass value="0.0015"/>
      <inertia ixx="1e-6" ixy="0" ixz="0" iyy="1e-6" iyz="0" izz="1e-7"/>
    </inertial>
    <visual>
      <origin xyz="0.02 0 0" rpy="0 1.5708 0"/>
      <geometry>
        <cylinder radius="0.0025" length="0.04"/>
      </geometry>
    </visual>
    <collision>
      <origin xyz="0.02 0 0" rpy="0 1.5708 0"/>
      <geometry>
        <cylinder radius="0.0025" length="0.04"/>
      </geometry>
    </collision>
  </link>
  <joint name="arm_joint_0" type="fixed">
    <parent link="base_link"/>
    <child link="arm_0"/>
    <origin xyz="0.015 0 0" rpy="0 0 0"/>
  </joint>

  <!-- Rotor 0 -->
  <link name="rotor_0">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.002"/>
      <inertia ixx="1e-7" ixy="0" ixz="0" iyy="1e-7" iyz="0" izz="5e-7"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.023" length="0.003"/>
      </geometry>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.023" length="0.003"/>
      </geometry>
    </collision>
  </link>
  <joint name="rotor_0" type="revolute">
    <parent link="arm_0"/>
    <child link="rotor_0"/>
    <origin xyz="0.04 0 0" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit effort="100" velocity="10000" lower="-100000" upper="100000"/>
  </joint>

  <!-- Arm 1: -X direction -->
  <link name="arm_1">
    <inertial>
      <origin xyz="-0.02 0 0" rpy="0 0 0"/>
      <mass value="0.0015"/>
      <inertia ixx="1e-6" ixy="0" ixz="0" iyy="1e-6" iyz="0" izz="1e-7"/>
    </inertial>
    <visual>
      <origin xyz="-0.02 0 0" rpy="0 1.5708 0"/>
      <geometry>
        <cylinder radius="0.0025" length="0.04"/>
      </geometry>
    </visual>
    <collision>
      <origin xyz="-0.02 0 0" rpy="0 1.5708 0"/>
      <geometry>
        <cylinder radius="0.0025" length="0.04"/>
      </geometry>
    </collision>
  </link>
  <joint name="arm_joint_1" type="fixed">
    <parent link="base_link"/>
    <child link="arm_1"/>
    <origin xyz="-0.015 0 0" rpy="0 0 0"/>
  </joint>

  <!-- Rotor 1 -->
  <link name="rotor_1">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.002"/>
      <inertia ixx="1e-7" ixy="0" ixz="0" iyy="1e-7" iyz="0" izz="5e-7"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.023" length="0.003"/>
      </geometry>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.023" length="0.003"/>
      </geometry>
    </collision>
  </link>
  <joint name="rotor_1" type="revolute">
    <parent link="arm_1"/>
    <child link="rotor_1"/>
    <origin xyz="-0.04 0 0" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit effort="100" velocity="10000" lower="-100000" upper="100000"/>
  </joint>

  <!-- Arm 2: +Y direction -->
  <link name="arm_2">
    <inertial>
      <origin xyz="0 0.02 0" rpy="0 0 0"/>
      <mass value="0.0015"/>
      <inertia ixx="1e-6" ixy="0" ixz="0" iyy="1e-6" iyz="0" izz="1e-7"/>
    </inertial>
    <visual>
      <origin xyz="0 0.02 0" rpy="0 0 1.5708"/>
      <geometry>
        <cylinder radius="0.0025" length="0.04"/>
      </geometry>
    </visual>
    <collision>
      <origin xyz="0 0.02 0" rpy="0 0 1.5708"/>
      <geometry>
        <cylinder radius="0.0025" length="0.04"/>
      </geometry>
    </collision>
  </link>
  <joint name="arm_joint_2" type="fixed">
    <parent link="base_link"/>
    <child link="arm_2"/>
    <origin xyz="0 0.015 0" rpy="0 0 0"/>
  </joint>

  <!-- Rotor 2 -->
  <link name="rotor_2">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.002"/>
      <inertia ixx="1e-7" ixy="0" ixz="0" iyy="1e-7" iyz="0" izz="5e-7"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.023" length="0.003"/>
      </geometry>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.023" length="0.003"/>
      </geometry>
    </collision>
  </link>
  <joint name="rotor_2" type="revolute">
    <parent link="arm_2"/>
    <child link="rotor_2"/>
    <origin xyz="0 0.04 0" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit effort="100" velocity="10000" lower="-100000" upper="100000"/>
  </joint>

  <!-- Arm 3: -Y direction -->
  <link name="arm_3">
    <inertial>
      <origin xyz="0 -0.02 0" rpy="0 0 0"/>
      <mass value="0.0015"/>
      <inertia ixx="1e-6" ixy="0" ixz="0" iyy="1e-6" iyz="0" izz="1e-7"/>
    </inertial>
    <visual>
      <origin xyz="0 -0.02 0" rpy="0 0 1.5708"/>
      <geometry>
        <cylinder radius="0.0025" length="0.04"/>
      </geometry>
    </visual>
    <collision>
      <origin xyz="0 -0.02 0" rpy="0 0 1.5708"/>
      <geometry>
        <cylinder radius="0.0025" length="0.04"/>
      </geometry>
    </collision>
  </link>
  <joint name="arm_joint_3" type="fixed">
    <parent link="base_link"/>
    <child link="arm_3"/>
    <origin xyz="0 -0.015 0" rpy="0 0 0"/>
  </joint>

  <!-- Rotor 3 -->
  <link name="rotor_3">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.002"/>
      <inertia ixx="1e-7" ixy="0" ixz="0" iyy="1e-7" iyz="0" izz="5e-7"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.023" length="0.003"/>
      </geometry>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.023" length="0.003"/>
      </geometry>
    </collision>
  </link>
  <joint name="rotor_3" type="revolute">
    <parent link="arm_3"/>
    <child link="rotor_3"/>
    <origin xyz="0 -0.04 0" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit effort="100" velocity="10000" lower="-100000" upper="100000"/>
  </joint>

</robot>
